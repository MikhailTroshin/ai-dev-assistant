# ============================================================
# AI Dev Assistant — пример конфигурации
# Скопируй в .env и заполни значения: cp .env.example .env
# ============================================================

# --- Redis ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# --- Пути ---
PROJECT_PATH=/home/USER/ai_assistant
# Дефолтный репозиторий (используется, если пользователь не выбрал проект через /project)
ML_REPO_PATH=/home/USER/ragllm

# --- Claude Code ---
CLAUDE_CODE_PATH=claude
# Таймаут-фолбэк для команд, которых нет в COMMAND_TIMEOUTS (сек)
CLAUDE_TIMEOUT=600

# --- Таймауты задач ---
# Потолок arq для ЛЮБОЙ задачи (сек). Должен быть >= максимального значения
# в COMMAND_TIMEOUTS + CLAUDE_TIMEOUT_MARGIN (по умолчанию в коде:
# task=3600 + margin 60 => минимум 3660; 3900 даёт запас).
TASK_TIMEOUT=3900
POLL_INTERVAL=5

# (Опционально) Переопределение таймаутов по командам — JSON-строкой.
# Это значения по умолчанию из кода; раскомментируй и меняй при нужде:
# COMMAND_TIMEOUTS={"ask": 600, "task": 3600, "bug": 1800, "code-review": 1800, "rebase": 1800}

# --- База данных (аудит задач) ---
DATABASE_URL=sqlite+aiosqlite:///data/assistant.db

# --- Логирование ---
LOG_LEVEL=INFO
LOG_FILE=logs/assistant.log

# --- Telegram ---
TELEGRAM_BOT_TOKEN=123456789:AA_your_bot_token
TELEGRAM_ADMIN_ID=123456789

# ============================================================
# MCP-серверы (не парсятся из .env, а используются скриптом
# deploy/install_host_deps.sh для настройки Claude Code).
# Заполни их здесь только как памятку — сами значения скрипт
# спросит интерактивно или возьмёт из переменных ниже.
# ============================================================
# JIRA_URL=https://your-jira.atlassian.net
# JIRA_USERNAME=your@email.com
# JIRA_API_TOKEN=...
# GITLAB_API_URL=https://gitlab.yourcompany.com/api/v4
# GITLAB_PERSONAL_ACCESS_TOKEN=...
